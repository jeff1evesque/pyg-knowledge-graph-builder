# Sizing profile for a large multi-source run. Source it BEFORE the variables that
# identify your cluster:
#
#   . bin/profiles/large-run.env
#   . ~/my-cluster.env          # master URL, driver host, bucket paths -- NOT tracked
#   bin/submit_spark_job.sh --mode full ...
#
# WHAT BELONGS HERE: values consumed by bin/submit_spark_job.sh that describe how big
# the job is. Nothing here names a host, an address, a bucket, an account or a path, so
# this file is safe to track. Keep it that way -- anything that identifies a deployment
# goes in an untracked file you source afterwards.
#
# WHAT THIS IS SIZED FOR: a four-source day where one source dominates -- measured at
# 347M triples total, of which the market source is 345M (99.5%). That run reads a whole
# day of intraday snapshots rather than a single one; the difference is a directory path
# versus a file path, and it is worth ~19x. A single-snapshot run needs none of this and
# should just use the script's defaults.
#
# CHECK THIS BUDGET BEFORE RAISING ANYTHING. On a unified-memory GPU the RMM pool comes
# out of host RAM, so it competes with the heaps:
#
#   max_fraction x host RAM  +  executor heap  +  driver heap  +  pinned pool
#     0.35 x 121 = 42        +       48        +      16       +      4       = 110 GiB
#
# which fits the 121 GiB host these were measured on. The previous values (0.5/0.7, 64g)
# asked for 169 GiB: the OOM-killer took the executor at 67 minutes, and its
# localCheckpoint blocks went with it. Redo this math for your own host.

# The script's 4g default is a floor chosen to be safe on any worker -- Spark waits
# forever rather than failing when an executor request exceeds what a worker can offer,
# so the default errs small on purpose. 48g, not 64g: the executor is what the OOM-killer
# picked. The driver keeps 16g; it was never the problem.
export EXECUTOR_MEMORY=48g
export DRIVER_MEMORY=16g

# The script's defaults are 0.25/0.4. 0.35 is below its cap on purpose, because this host
# also carries the driver. Both must move together -- raising alloc alone cannot grow the
# pool past the cap.
export RAPIDS_GPU_ALLOC_FRACTION=0.25
export RAPIDS_GPU_MAX_ALLOC_FRACTION=0.35

# The lever to reach for first, because it costs no host memory. Task slots per executor
# are min(cores/task.cpus, gpu/task.gpu), so the 0.125 default puts 8 tasks on one RMM
# pool -- that crowding caused 215,144 "maximum pool size exceeded" lines from a single
# executor. 0.25 gives 4 slots, so each gets twice the pool out of the same pool. Costs
# GPU-stage parallelism, not memory.
export GPU_PER_TASK=0.25

# Host memory staged for host<->device transfer, divided among the task slots above --
# four ways at the GPU_PER_TASK set here, not eight.
export RAPIDS_PINNED_POOL=4G

# A busy executor can go quiet for longer than the stock 120s without being dead: one
# stalled for 173s inside block eviction, was evicted, and destroyed the localCheckpoint
# blocks it held -- which aborted the job with "Checkpoint block rdd_N not found" after
# 2.5 hours. Those blocks have no replica, so eviction is not recoverable mid-run.
# The trade is real: a genuinely dead executor also goes undetected for 10 minutes.
# This only helps an executor that is alive but quiet. One that dies still ends the job.
export NETWORK_TIMEOUT=600s
export EXECUTOR_HEARTBEAT_INTERVAL=30s

# RAPIDS_EXPLAIN=ALL renders a plan per execution across ~1,300 stages. On the run above
# it was a material part of a 306 MB / 1.9M-line driver log, which is slow to write and
# slower to search. Turn it on deliberately when diagnosing GPU fallback, not by default.
# Note that multi_experiment.ipynb counts GPU operators by matching "will run on GPU" in
# the log, so with NONE it wrongly reports "NO GPU" for every leg.
export RAPIDS_EXPLAIN=NONE
