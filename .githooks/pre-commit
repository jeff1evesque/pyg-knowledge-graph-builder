#!/bin/sh
#
# Reject staged changes containing invisible or homoglyph-prone Unicode, or a
# committed secret.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# This mirrors the `unicode` and `gitleaks` GitHub Actions workflows so the same
# rules apply locally and in CI. CI is the enforcement -- this hook only fails
# faster, and can be bypassed with `git commit --no-verify`.
#
# Both checkers are stdlib-only and read their rules from files in the
# repository, so a fresh clone is protected with nothing installed. The secret
# check is a SUBSET of what CI runs: CI additionally scans full history with
# gitleaks and its ~150 provider rules.
#
# The Python lint below is the one exception: it requires ruff, and refuses to
# commit staged Python without it. See the note above that block.
#
set -e

python3 scripts/check_unicode.py --staged
python3 scripts/check_secrets.py --staged

#
# Lint the staged Python files. Mirrors the `lint` GitHub Actions workflow,
# which reads the same .ruff.toml, so the hook and CI cannot disagree about
# which rules apply.
#
# Unlike the two checks above, this one is NOT stdlib-only -- it needs ruff.
# A missing ruff is a HARD FAILURE, not a skip. A lint that silently opts out
# on the machines lacking the tool is not a lint: it passes locally, then fails
# in CI on a commit already pushed and branched from. To bypass it, bypass the
# whole hook explicitly with `git commit --no-verify` -- an opt-out visible in
# the command that used it, rather than one buried in the environment.
#
# ruff is looked for in the project venv BEFORE PATH, because the usual case is
# a venv that exists but is not activated in the committing shell -- VS Code's
# git UI and any plain terminal both hit that, and `command -v` alone would
# miss .venv/bin/ruff and take the skip.
#
staged_python=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$' || true)

if [ -n "${staged_python}" ]; then
    repo_root=$(git rev-parse --show-toplevel)

    if [ -x "${repo_root}/.venv/bin/ruff" ]; then
        ruff_bin="${repo_root}/.venv/bin/ruff"
    elif command -v ruff >/dev/null 2>&1; then
        ruff_bin=ruff
    else
        echo 'pre-commit: ruff is not installed, and the Python lint is required.' >&2
        echo '            Install it into the project venv:' >&2
        echo '                .venv/bin/pip install -r requirements-test.txt' >&2
        echo '            or globally, at the version CI pins:' >&2
        echo '                pip install ruff==0.16.1' >&2
        exit 1
    fi

    # --force-exclude makes ruff honour the exclusions in .ruff.toml even
    # though the paths are being named explicitly here.
    echo "${staged_python}" | xargs "${ruff_bin}" check --force-exclude --
fi
